---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryLabels,
  formatDate,
  getActiveContests,
  getContestImage,
  getContestPlaceholderType,
  getDaysUntilDeadline,
  isContestFallbackImage,
} from "@/lib/contests";

const contests = await getActiveContests();
---

<BaseLayout title="締切カレンダー" description="AI創作コンテストの締切をカレンダー風に確認できます。">
  <section class="page-hero">
    <div class="site-shell">
      <p class="eyebrow">Deadline Calendar</p>
      <h1>締切カレンダー</h1>
      <p class="lead">締切日が近い順に、応募予定を確認できます。</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell calendar-list">
      {
        contests.map((contest) => {
          const days = getDaysUntilDeadline(contest.deadline);
          const thumbnail = getContestImage(contest);
          const isFallbackThumbnail = isContestFallbackImage(thumbnail);
          const placeholderType = getContestPlaceholderType(contest);
          return (
            <a class={`calendar-item placeholder-${placeholderType} ${isFallbackThumbnail ? "is-fallback" : ""}`} href={`/contests/${contest.slug}`}>
              <span class="calendar-thumb" aria-hidden="true">
                <img
                  src={thumbnail}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror="this.onerror=null;this.src='/images/contest-fallback.png';this.closest('.calendar-item')?.classList.add('is-fallback');"
                />
              </span>
              <div class="date-block">
                <span>締切</span>
                <strong>{formatDate(contest.deadline)}</strong>
              </div>
              <div class="calendar-item-main">
                <strong>{contest.title}</strong>
                <div class="meta-line">
                  {contest.categories.map((category) => categoryLabels[category]).join(" / ")} ・ {contest.applicationMethod}
                </div>
              </div>
              <span class={`pill ${days <= 7 ? "urgent" : ""}`}>{days >= 0 ? `あと${days}日` : "終了"}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
