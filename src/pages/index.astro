---
import ContestCard from "@/components/ContestCard.astro";
import DeadlineSoonCard from "@/components/DeadlineSoonCard.astro";
import CategoryLinks from "@/components/CategoryLinks.astro";
import CtaSection from "@/components/CtaSection.astro";
import GuideCard from "@/components/GuideCard.astro";
import Hero from "@/components/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ContestCategory } from "@/data/contests";
import { getAllGuides } from "@/data/guides";
import { getActiveContests, getClosingSoonContests, getFeaturedContests, publicCategories } from "@/lib/contests";

const featured = await getFeaturedContests(4);
const closingSoon = await getClosingSoonContests(5);
const activeContests = await getActiveContests();
const featuredGuides = (await getAllGuides()).slice(0, 3);
const deadlinePicks = closingSoon.length > 0 ? closingSoon : activeContests.slice(0, 5);
const categoryCounts = Object.fromEntries(
  publicCategories.map((category) => [
    category,
    activeContests.filter((contest) => contest.categories.includes(category)).length,
  ]),
) as Partial<Record<ContestCategory, number>>;
---

<BaseLayout
  title="ゆるコンテストなび｜気軽に参加できるコンテストが見つかる"
  description="イラスト・AI画像・動画・写真・音楽・X投稿など、初心者にも参加しやすいコンテストを紹介。締切・賞品・応募方法もわかりやすくチェックできます。"
  ogImage="/images/brand/yuru-og-home.webp"
>
  <Hero featured={featured} />

  <section id="featured" class="section top-section">
    <div class="site-shell">
      <div class="section-head">
        <div>
          <h2 class="section-title">注目のコンテスト</h2>
          <p class="section-copy">まず見ておきたい、参加しやすい募集をピックアップ。</p>
        </div>
        <a class="button" href="/contests">すべて見る</a>
      </div>
      <div class="featured-grid">
        {featured.map((contest) => <ContestCard contest={contest} variant="featured" />)}
      </div>
    </div>
  </section>

  <section class="section guide-strip-section">
    <div class="site-shell">
      <div class="section-head">
        <div>
          <h2 class="section-title">初めての方へ</h2>
          <p class="section-copy">応募の流れ、選び方、応募前のポイントをやさしくまとめました。</p>
        </div>
        <a class="button" href="/guides">もっと見る</a>
      </div>
      <div class="guide-grid guide-grid-home">
        {featuredGuides.map((guide) => <GuideCard guide={guide} compact minimal />)}
      </div>
    </div>
  </section>

  <section id="categories" class="section creation-section">
    <div class="site-shell">
      <div class="section-head">
        <div>
          <h2 class="section-title">作りたいものから探す</h2>
          <p class="section-copy">近いジャンルから、無理なく探せます。</p>
        </div>
      </div>
      <CategoryLinks counts={categoryCounts} />
    </div>
  </section>

  <section id="deadline-soon" class="section deadline-showcase-section">
    <div class="site-shell">
      <div class="deadline-showcase-panel">
        <div class="section-head deadline-showcase-head">
          <div>
            <h2 class="section-title deadline-title"><span>締切が近い</span><span>コンテスト</span></h2>
            <p class="section-copy">そろそろ準備したい、締切が近い募集。</p>
          </div>
          <a class="button deadline-more-button" href="/calendar">すべて見る</a>
        </div>
        <div class="deadline-rail">
          {deadlinePicks.slice(0, 4).map((contest) => <DeadlineSoonCard contest={contest} />)}
        </div>
        <p class="deadline-footnote">毎日更新！締切まであとわずかなコンテストをピックアップしています。</p>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
