---
import GuideCard from "@/components/GuideCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllGuides } from "@/data/guides";

const guides = await getAllGuides();
---

<BaseLayout
  title="コンテスト応募ガイド"
  description="初めてでも迷いにくい、コンテストの選び方・応募の流れ・提出前チェックのガイド。"
  canonical={new URL("/guides", Astro.site).toString()}
  ogImage="/images/brand/yuru-og-home.webp"
>
  <section class="page-hero guide-page-hero">
    <div class="site-shell">
      <p class="eyebrow">Guides</p>
      <h1>コンテスト応募ガイド</h1>
      <p class="lead">初めての応募に必要なことを、3つにまとめました。</p>
      <div class="hero-actions">
        <a class="button primary" href="/contests">コンテストを探す</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="guide-grid guide-grid-list">
        {guides.map((guide) => <GuideCard guide={guide} minimal />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 760px) {
    .guide-page-hero h1 {
      font-size: 1.9rem;
    }
  }
</style>
