---
import BaseLayout from "@/layouts/BaseLayout.astro";
import XContactButton from "@/components/XContactButton.astro";

const flow = [
  ["1", "送る", "公式ページのURLをXのDMへ。"],
  ["2", "確認", "募集内容を公式情報で確認します。"],
  ["3", "掲載", "応募者が見やすい形に整えて公開します。"],
];
const requiredItems = [
  "コンテスト名",
  "公式ページURL",
  "応募締切",
  "賞金・賞品",
  "応募形式",
  "公式画像（あれば）",
];
---

<BaseLayout
  title="コンテストの掲載依頼"
  description="コンテスト情報を、公式情報にもとづいてゆるコンテストなびに掲載します。"
  canonical={new URL("/submit", Astro.site).toString()}
  ogImage="/images/brand/yuru-og-home.webp"
>
  <section class="page-hero submit-hero">
    <div class="site-shell submit-hero-grid">
      <div>
        <p class="eyebrow">Submit Contest</p>
        <h1>コンテストの掲載依頼</h1>
        <p class="lead">公式ページのURLを添えて、XのDMからお送りください。</p>
        <div class="hero-actions">
          <XContactButton label="Xで掲載依頼する" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell submit-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">掲載までの流れ</h2>
        </div>
      </div>
      <div class="submit-flow-grid">
        {flow.map(([number, title, text]) => (
          <article class="submit-flow-card">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="required-info" class="section">
    <div class="site-shell submit-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">掲載に必要な情報</h2>
          <p class="section-copy">わかる範囲で大丈夫です。</p>
        </div>
      </div>
      <div class="submit-check-grid">
        {requiredItems.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell submit-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">掲載について</h2>
        </div>
      </div>
      <div class="submit-plan-grid">
        <article>
          <h3>通常掲載</h3>
          <p>公式情報を確認し、締切や応募条件を整理して掲載します。</p>
        </article>
        <article>
          <h3>PR掲載</h3>
          <p>PR表記を付け、内容や導線を相談して掲載します。</p>
        </article>
      </div>
      <p class="submit-inline-note">公式情報を確認できない場合は掲載できません。修正・削除もXのDMで受け付けています。</p>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 760px) {
    .submit-hero h1 {
      font-size: 1.9rem;
    }
  }
</style>
