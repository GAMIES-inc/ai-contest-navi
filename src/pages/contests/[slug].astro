---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContestCard from "@/components/ContestCard.astro";
import ImageSource from "@/components/ImageSource.astro";
import { categoryLabels, formatDate, getAllContests, getContestBySlug, getContestFallbackImage, getContestImage, getContestPlaceholderType, getDaysUntilDeadline, isContestFallbackImage } from "@/lib/contests";
import CalendarDays from "@lucide/astro/icons/calendar-days";
import CalendarPlus from "@lucide/astro/icons/calendar-plus";
import ClipboardList from "@lucide/astro/icons/clipboard-list";
import FileCheck from "@lucide/astro/icons/file-check";
import Lightbulb from "@lucide/astro/icons/lightbulb";
import ListChecks from "@lucide/astro/icons/list-checks";
import Send from "@lucide/astro/icons/send";
import TriangleAlert from "@lucide/astro/icons/triangle-alert";
import Trophy from "@lucide/astro/icons/trophy";

export async function getStaticPaths() {
  return (await getAllContests()).map((contest) => ({
    params: { slug: contest.slug },
  }));
}

const contest = await getContestBySlug(Astro.params.slug ?? "");

if (!contest) {
  return Astro.redirect("/contests");
}

const fallbackThumbnail = getContestFallbackImage(contest);
const thumbnail = getContestImage(contest);
const isFallbackThumbnail = isContestFallbackImage(thumbnail);
const placeholderType = getContestPlaceholderType(contest);
const ogImage = isFallbackThumbnail ? fallbackThumbnail : thumbnail;
const imageSourceLabel = !isFallbackThumbnail ? contest.imageSourceLabel || "公式ページ" : "";
const imageSourceUrl = !isFallbackThumbnail ? contest.imageSourceUrl || contest.officialUrl : "";
const relatedContests = (await getAllContests())
  .filter((item) => item.slug !== contest.slug && (item.status === "open" || item.status === "closing-soon"))
  .sort((a, b) => {
    const aOverlap = a.categories.filter((category) => contest.categories.includes(category)).length;
    const bOverlap = b.categories.filter((category) => contest.categories.includes(category)).length;
    return bOverlap - aOverlap || a.deadline.localeCompare(b.deadline);
  })
  .slice(0, 3);
const officialCtaLabel = "公式で応募条件を確認する";
const enableFirstPartyAnalytics = import.meta.env.PUBLIC_ENABLE_FIRST_PARTY_ANALYTICS === "true";
const officialGoHref = (from: string) =>
  enableFirstPartyAnalytics ? `/go/${contest.slug}?link=official&from=${from}` : contest.officialUrl;
const calendarDate = (() => {
  const start = contest.deadline.replaceAll("-", "");
  const [year, month, day] = contest.deadline.split("-").map(Number);
  const endDate = new Date(Date.UTC(year, month - 1, day + 1));
  const end = `${endDate.getUTCFullYear()}${String(endDate.getUTCMonth() + 1).padStart(2, "0")}${String(endDate.getUTCDate()).padStart(2, "0")}`;
  return `${start}/${end}`;
})();
const googleCalendarUrl = `https://calendar.google.com/calendar/render?${new URLSearchParams({
  action: "TEMPLATE",
  text: `${contest.title} 応募締切`,
  dates: calendarDate,
  details: `応募前に公式ページで最新の応募条件をご確認ください。\n${contest.officialUrl}`,
  location: contest.officialUrl,
}).toString()}`;
const isXUrl = (value: string) => {
  try {
    const hostname = new URL(value).hostname.replace(/^www\./, "");
    return hostname === "x.com" || hostname === "twitter.com";
  } catch {
    return false;
  }
};
const isSocialApplication =
  isXUrl(contest.officialUrl) ||
  /X|SNS|twitter|フォロー|リポスト|引用投稿/i.test(`${contest.title} ${contest.description} ${contest.applicationMethod}`);
const hasVideo = contest.categories.includes("ai-video");
const hasManga = contest.categories.includes("ai-manga");
const hasImage = contest.categories.includes("ai-image") || contest.categories.includes("ai-illustration");
const hasMusic = contest.categories.includes("ai-music");
const hasDesign = contest.categories.includes("design");
const formatCompact = (value: string, max = 22) => {
  const normalized = value.replace(/\s+/g, " ").trim();
  return normalized.length > max ? `${normalized.slice(0, max - 1)}…` : normalized;
};
const firstSentence = (value: string, max = 58) => {
  const sentence = value.split("。").find(Boolean)?.trim() || value.trim();
  return formatCompact(sentence, max);
};
const shortLead = (value: string, max = 30) => {
  const sentence = value.split("。").find(Boolean)?.trim() || value.trim();
  return sentence.length > max ? `${sentence.slice(0, max)}。` : sentence;
};
const buildInlineLines = (value: string, max = 18) => value.match(new RegExp(`.{1,${max}}`, "gu")) ?? [value];
const applicationShort = (() => {
  const text = `${contest.applicationMethod} ${contest.officialUrl}`;
  if (/YouTube/i.test(text)) return "YouTube提出";
  if (/note\.com|noteに|noteの/i.test(text)) return "note投稿";
  if (isSocialApplication) return "X投稿";
  if (/フォーム|form/i.test(text)) return "公式フォーム";
  if (/メール|mail/i.test(text)) return "メール応募";
  if (/サイト|提出|応募ページ|entry/i.test(text)) return "サイト提出";
  return formatCompact(contest.applicationMethod, 14);
})();
const workFormat = (() => {
  const formats = [
    hasImage ? "画像" : "",
    hasVideo ? "動画" : "",
    hasManga ? "漫画" : "",
    hasMusic ? "音楽" : "",
    hasDesign ? "デザイン" : "",
  ].filter(Boolean);
  return formats.length ? formats.join(" / ") : categoryLabels[contest.categories[0]] || "作品";
})();
const prizeShort = (() => {
  const match = contest.prize.match(/賞金総額\s*[0-9,]+円|[0-9,]+万円|[0-9,]+円|表彰あり|賞あり/);
  return match ? match[0] : formatCompact(contest.prize, 18);
})();
const heroCatchcopy = shortLead(contest.description, 30);
const detailCatchcopy = contest.catchcopy ? shortLead(contest.catchcopy, 30) : heroCatchcopy;
const detailLeadLines = buildInlineLines(detailCatchcopy, 18);
const titleWords = contest.title.split(/\s+/u).filter(Boolean);
const daysUntilDeadline = getDaysUntilDeadline(contest.deadline);
const deadlineUrgency = daysUntilDeadline === 0
  ? "今日が締切です"
  : daysUntilDeadline === 1
    ? "締切まであと1日"
    : `締切まであと${daysUntilDeadline}日`;
const quickFacts = [
  { label: "締切", value: formatDate(contest.deadline), icon: CalendarDays },
  { label: "作品形式", value: workFormat, icon: FileCheck },
  { label: "応募方法", value: applicationShort, icon: Send },
  { label: "賞金・賞品", value: prizeShort, icon: Trophy, emphasis: true },
];
const fallbackFlowSteps = [
  { title: "作品やアイデアを用意", body: `${workFormat}の条件に合わせて、応募する内容を整えます。`, icon: Lightbulb },
  { title: "公式条件を確認して応募", body: `締切・提出形式を確認し、${applicationShort}で進めます。`, icon: ClipboardList },
  { title: "結果や案内を待つ", body: "応募後は公式からの連絡や発表を確認します。", icon: Send },
];
const flowIcons = [Lightbulb, ClipboardList, Send];
const flowSteps = contest.entryFlow?.length
  ? contest.entryFlow.slice(0, 3).map((item, index) => {
      const [title, body] = item.split(/[:：]/u).map((part) => part.trim());
      return {
        title: title || item,
        body: body || (index === 0 ? "応募に必要な準備を進めます。" : index === 1 ? "公式条件を確認しながら応募します。" : "応募後の案内を確認します。"),
        icon: flowIcons[index] ?? Send,
      };
    })
  : fallbackFlowSteps;
---

<BaseLayout
  title={contest.title}
  description={contest.description}
  canonical={new URL(`/contests/${contest.slug}`, Astro.site).toString()}
  ogImage={ogImage}
>
  <section class="page-hero">
    <div class="site-shell detail-hero detail-hero-redesign">
      <div class="detail-hero-copy">
        <p class="eyebrow">CONTEST DETAIL</p>
        <h1>
          {titleWords.map((word) => <span class="detail-title-word">{word}</span>)}
        </h1>
        <p class="lead">
          {detailLeadLines.map((line) => <span class="detail-lead-line">{line}</span>)}
        </p>
        <div class="tags">
          {contest.categories.slice(0, 2).map((category) => <span class="tag">{categoryLabels[category]}</span>)}
        </div>
        <div class="hero-actions detail-primary-actions">
          <a
            class="button primary"
            href={officialGoHref("detail_hero")}
            target="_blank"
            rel="noopener"
            data-analytics-link="official"
            data-contest-slug={contest.slug}
            data-detail-primary-cta
          >
            {officialCtaLabel}
          </a>
          <a class="button detail-calendar-button" href={googleCalendarUrl} target="_blank" rel="noopener">
            <CalendarPlus size={19} stroke-width={2} />
            カレンダーに追加
          </a>
        </div>
        <p class="detail-deadline-note"><CalendarDays size={17} stroke-width={2.1} />{deadlineUrgency}・{formatDate(contest.deadline)}まで</p>
      </div>
      <div class="detail-image-wrap">
        <div class={`detail-image placeholder-${placeholderType} ${isFallbackThumbnail ? "is-fallback" : ""}`}>
          <img src={thumbnail} data-fallback-src={fallbackThumbnail} alt={contest.imageAlt || `${contest.title}のキービジュアル`} loading="eager" decoding="async" onerror="this.onerror=null;this.src=this.dataset.fallbackSrc || '/images/contests/yuru-thumb-ai-image.webp';" />
        </div>
        <ImageSource label={imageSourceLabel} url={imageSourceUrl} rightsOwner={contest.imageRightsOwner} />
      </div>
    </div>
  </section>

  <section class="section contest-detail-main">
    <div class="site-shell contest-decision-layout">
      <section class="contest-about-card" aria-labelledby="contest-about">
        <div class="contest-about-icon" aria-hidden="true">
          <Lightbulb size={42} stroke-width={1.8} />
        </div>
        <div>
          <h2 id="contest-about">このコンテストについて</h2>
          <p>{contest.description}</p>
        </div>
      </section>

      <section class="detail-section-block" aria-labelledby="quick-facts">
        <h2 id="quick-facts" class="detail-section-title">
          <ListChecks size={25} stroke-width={2.1} />
          応募情報
        </h2>
        <div class="quick-facts-grid">
          {quickFacts.map((fact) => {
            const Icon = fact.icon;
            return (
              <div class={`quick-fact-card ${fact.emphasis ? "is-emphasis" : ""}`}>
                <Icon size={30} stroke-width={1.9} />
                <span>{fact.label}</span>
                <strong>{fact.value}</strong>
              </div>
            );
          })}
        </div>
      </section>

      <section class="detail-section-block" aria-labelledby="entry-flow">
        <h2 id="entry-flow" class="detail-section-title">
          <ClipboardList size={25} stroke-width={2.1} />
          応募の流れ
        </h2>
        <div class="entry-flow-grid">
          {flowSteps.map((step, index) => {
            const StepIcon = step.icon;
            return (
              <article class="entry-flow-card">
                <span class="entry-flow-number">{index + 1}</span>
                <StepIcon size={28} stroke-width={1.9} />
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="detail-caution-box" aria-labelledby="detail-caution">
        <TriangleAlert size={34} stroke-width={1.9} />
        <div>
          <h2 id="detail-caution">応募前に確認</h2>
          <p>最新の条件と作品の権利について、公式ページをご確認ください。</p>
        </div>
      </section>
    </div>
  </section>
  {relatedContests.length > 0 && (
    <section class="section related-contests-section">
      <div class="site-shell">
        <div class="section-head">
          <div>
            <h2 class="section-title">似ている募集中のコンテスト</h2>
            <p class="section-copy">同じジャンルの募集。</p>
          </div>
          <a class="button" href="/contests">すべて見る</a>
        </div>
        <div class="grid contest-list-grid related-contest-grid">
          {relatedContests.map((item) => <ContestCard contest={item} />)}
        </div>
      </div>
    </section>
  )}
  <div class="detail-sticky-spacer" aria-hidden="true"></div>
  <div class="detail-sticky-cta" aria-label="公式ページへの応募導線">
    <span>{deadlineUrgency}</span>
    <a
      class="button primary"
      href={officialGoHref("detail_sticky")}
      target="_blank"
      rel="noopener"
      data-analytics-link="official"
      data-contest-slug={contest.slug}
    >
      公式条件を確認
    </a>
  </div>
  <script is:inline>
    (() => {
      const primary = document.querySelector("[data-detail-primary-cta]");
      const sticky = document.querySelector(".detail-sticky-cta");
      if (!primary || !sticky) return;
      if (!("IntersectionObserver" in window)) {
        sticky.classList.add("is-visible");
        return;
      }
      const observer = new IntersectionObserver(([entry]) => {
        sticky.classList.toggle("is-visible", !entry.isIntersecting);
      }, { threshold: 0.05 });
      observer.observe(primary);
    })();
  </script>
</BaseLayout>
