---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLabels, formatDate, getAllContests, getContestBySlug } from "@/lib/contests";

export async function getStaticPaths() {
  return (await getAllContests()).map((contest) => ({
    params: { slug: contest.slug },
  }));
}

const contest = await getContestBySlug(Astro.params.slug ?? "");

if (!contest) {
  return Astro.redirect("/contests");
}

const ogImage = contest.thumbnail === "/brand-thumbnail.svg" ? "/og-contest.svg" : contest.thumbnail;
---

<BaseLayout
  title={contest.title}
  description={contest.description}
  canonical={new URL(`/contests/${contest.slug}`, Astro.site).toString()}
  ogImage={ogImage}
>
  <section class="page-hero">
    <div class="site-shell detail-hero">
      <div>
        <p class="eyebrow">Contest Detail</p>
        <h1>{contest.title}</h1>
        <p class="lead">{contest.description}</p>
        <div class="tags">
          {contest.categories.map((category) => <span class="tag">{categoryLabels[category]}</span>)}
        </div>
        <div class="hero-actions">
          <a class="button primary" href={contest.officialUrl} target="_blank" rel="noreferrer">公式サイトを見る</a>
          <a class="button" href="/contests">一覧に戻る</a>
        </div>
      </div>
      <div class="detail-image">
        <img src={contest.thumbnail} alt="" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-panel">
      <h2>応募前に見ること</h2>
      <div class="info-grid">
        <div class="info-box"><span>締切日</span><strong>{formatDate(contest.deadline)}</strong></div>
        <div class="info-box"><span>応募形式</span><strong>{contest.applicationMethod}</strong></div>
        <div class="info-box"><span>賞金・賞品</span><strong>{contest.prize}</strong></div>
        <div class="info-box"><span>AI使用条件</span><strong>{contest.aiUsage}</strong></div>
        <div class="info-box"><span>参加しやすさ</span><strong>{contest.difficulty}</strong></div>
        <div class="info-box"><span>権利まわり</span><strong>{contest.rightsNote}</strong></div>
      </div>
      <p class="notice-box">掲載情報は要約です。応募前に必ず公式ページで、締切・提出形式・AI利用条件・著作権や二次利用条件をご確認ください。</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-panel">
      <h2>このコンテストの見どころ</h2>
      <p>{contest.description}</p>
      <p>制作中のAI作品を応募先につなげたい人、締切を決めて作品を完成させたい人に向いています。</p>
    </div>
  </section>

  <section class="section">
    <div class="site-shell content-panel">
      <h2>注意したいポイント</h2>
      <p>{contest.rightsNote}</p>
      <p>掲載情報は要約です。応募前には必ず公式ページで最新の募集要項を確認してください。</p>
      <p><a class="button" href={contest.officialUrl} target="_blank" rel="noreferrer">公式ページ</a></p>
    </div>
  </section>
</BaseLayout>
