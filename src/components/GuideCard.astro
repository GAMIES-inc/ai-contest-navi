---
import type { Guide } from "@/data/guides";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import CheckCheck from "@lucide/astro/icons/check-check";
import Clock3 from "@lucide/astro/icons/clock-3";

type Props = {
  guide: Guide;
  compact?: boolean;
};

const { guide, compact = false } = Astro.props;
const coverImage = guide.coverImage ?? "/images/contest-fallback.png";
const coverAlt = guide.coverAlt ?? "";
---

<article class={`guide-card ${compact ? "guide-card-compact" : ""}`}>
  <a class="guide-card-link" href={`/guides/${guide.slug}`} aria-label={`${guide.title}を読む`}>
    <span class="guide-cover-thumb">
      <img
        src={coverImage}
        alt={coverAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        onerror="this.onerror=null;this.src='/images/contest-fallback.png';this.closest('.guide-card')?.classList.add('is-fallback');"
      />
      <span class="guide-cover-shade" aria-hidden="true"></span>
      <span class="guide-category">{guide.category}</span>
    </span>
    <span class="guide-card-content">
      <h3>{guide.title}</h3>
      <p>{guide.description}</p>
      <span class="guide-benefit">{guide.learnings[0]}</span>
      <span class="guide-meta-row">
        <span><Clock3 size={15} stroke-width={2} />{guide.readTime}</span>
        <span><CheckCheck size={15} stroke-width={2} />{guide.difficulty}</span>
      </span>
      <span class="guide-button">読む <ArrowRight size={16} stroke-width={2.2} /></span>
    </span>
  </a>
</article>
