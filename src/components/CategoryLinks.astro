---
import CategoryCard from "@/components/CategoryCard.astro";
import type { ContestCategory } from "@/data/contests";
import { publicCategories } from "@/lib/contests";

type Props = {
  counts?: Partial<Record<ContestCategory, number>>;
};

const { counts = {} } = Astro.props;
---

<div class="category-grid">
  {
    publicCategories.map((category) => (
      <CategoryCard category={category} count={counts[category] ?? 0} />
    ))
  }
</div>
