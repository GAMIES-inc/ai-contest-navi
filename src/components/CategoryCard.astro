---
import type { ContestCategory } from "@/data/contests";
import { categoryLabels } from "@/lib/contests";
import BookOpen from "@lucide/astro/icons/book-open";
import ImageIcon from "@lucide/astro/icons/image";
import Music from "@lucide/astro/icons/music";
import Play from "@lucide/astro/icons/play";
import Sparkles from "@lucide/astro/icons/sparkles";

type Props = {
  category: ContestCategory;
  count?: number;
};

const { category, count = 0 } = Astro.props;

const meta: Record<string, { description: string; Icon: typeof ImageIcon; tone: string }> = {
  "ai-image": {
    description: "画像生成・加工の応募先",
    Icon: ImageIcon,
    tone: "cyan",
  },
  "ai-video": {
    description: "AI映像・短編動画の募集",
    Icon: Play,
    tone: "blue",
  },
  "ai-manga": {
    description: "漫画・イラスト作品向け",
    Icon: BookOpen,
    tone: "green",
  },
  "ai-music": {
    description: "作曲・音声作品を探す",
    Icon: Music,
    tone: "purple",
  },
  other: {
    description: "複合ジャンルや新形式",
    Icon: Sparkles,
    tone: "gold",
  },
};

const item = meta[category] ?? meta.other;
const Icon = item.Icon;
---

<a class={`category-card category-card-${item.tone}`} href={`/categories/${category}`}>
  <span class="category-icon" aria-hidden="true"><Icon size={34} stroke-width={1.9} /></span>
  <strong>{categoryLabels[category]}</strong>
  <span>{item.description}</span>
  <small>{count}件募集中</small>
</a>
