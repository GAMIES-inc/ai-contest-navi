---
import type { ContestCategory } from "@/data/contests";
import { categoryLabels } from "@/lib/contests";
import BookOpen from "@lucide/astro/icons/book-open";
import Camera from "@lucide/astro/icons/camera";
import ImageIcon from "@lucide/astro/icons/image";
import Music from "@lucide/astro/icons/music";
import Paintbrush from "@lucide/astro/icons/paintbrush";
import PenTool from "@lucide/astro/icons/pen-tool";
import Play from "@lucide/astro/icons/play";
import Sparkles from "@lucide/astro/icons/sparkles";

type Props = {
  category: ContestCategory;
  count?: number;
};

const { category, count = 0 } = Astro.props;

const meta: Record<string, { description: string; Icon: typeof ImageIcon; tone: string }> = {
  "ai-image": {
    description: "画像1枚から参加しやすい募集",
    Icon: ImageIcon,
    tone: "cyan",
  },
  "ai-video": {
    description: "ショート動画や映像作品向け",
    Icon: Play,
    tone: "blue",
  },
  "ai-illustration": {
    description: "イラスト・キャラクター作品向け",
    Icon: PenTool,
    tone: "orange",
  },
  photo: {
    description: "写真やフォト投稿で参加しやすい募集",
    Icon: Camera,
    tone: "blue",
  },
  "ai-manga": {
    description: "漫画やストーリー作品向け",
    Icon: BookOpen,
    tone: "green",
  },
  "ai-music": {
    description: "音楽や音声作品を探したい方へ",
    Icon: Music,
    tone: "purple",
  },
  design: {
    description: "ポスターやデザイン作品向け",
    Icon: Paintbrush,
    tone: "gold",
  },
  other: {
    description: "企画・アイデア・その他の募集",
    Icon: Sparkles,
    tone: "gold",
  },
};

const item = meta[category] ?? meta.other;
const Icon = item.Icon;
---

<a class={`category-card category-card-${item.tone}`} href={`/categories/${category}`}>
  <span class="category-icon" aria-hidden="true"><Icon size={34} stroke-width={1.9} /></span>
  <strong>{categoryLabels[category]}</strong>
  <span>{item.description}</span>
  <small>{count}件見つかる</small>
</a>
