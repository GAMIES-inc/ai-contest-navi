---
import { categoryLabels, formatDate, getContestFallbackImage, getContestImage, getContestPlaceholderType, isContestFallbackImage } from "@/lib/contests";
import type { Contest } from "@/data/contests";
import Gift from "@lucide/astro/icons/gift";
import Heart from "@lucide/astro/icons/heart";
import ImageIcon from "@lucide/astro/icons/image";
import Send from "@lucide/astro/icons/send";
import Sprout from "@lucide/astro/icons/sprout";

type Props = {
  contest: Contest;
  variant?: "default" | "featured";
};

const { contest, variant = "default" } = Astro.props;
const thumbnail = getContestImage(contest);
const fallbackThumbnail = getContestFallbackImage(contest);
const thumbnailLoading = thumbnail.startsWith("/images/contests/yuru-thumb-") ? "eager" : "lazy";
const isFallbackThumbnail = isContestFallbackImage(thumbnail);
const placeholderType = getContestPlaceholderType(contest);
const primaryCategory = categoryLabels[contest.categories[0]] ?? "コンテスト";
const hasPrize = !/賞金なし|賞品なし/.test(contest.prize) && /[0-9,]+(?:万)?円|ギフト(?:カード|券)|Amazon|賞金総額|懸賞金/.test(contest.prize);
const prizeMatch = contest.prize.match(/[0-9,]+(?:万)?円(?:分|相当)?|ギフト(?:カード|券)[^。、「」]{0,12}|Amazon[^。、「」]{0,14}/);
const prizeShort = hasPrize && prizeMatch ? prizeMatch[0] : /賞品|各賞|表彰|入賞/.test(contest.prize) ? "賞品あり" : "公式で確認";
const isBeginner = /初心者|初めて|標準|ゆる/.test(contest.difficulty);
const applicationText = `${contest.title} ${contest.description} ${contest.applicationMethod}`;
const isXApplication = /X|SNS|twitter|リポスト|引用投稿/i.test(applicationText);
const isPostApplication = !isXApplication && /note|投稿|ハッシュタグ/i.test(applicationText);
const isImageOnly = contest.categories.some((category) => category === "ai-image" || category === "ai-illustration") && !contest.categories.includes("ai-video") && !contest.categories.includes("ai-manga");
const effortTags = [
  isBeginner ? { label: "初心者OK", Icon: Sprout, tone: "mint" } : null,
  isImageOnly ? { label: "画像1枚でOK", Icon: ImageIcon, tone: "blue" } : null,
  isXApplication ? { label: "X投稿だけ", Icon: Send, tone: "navy" } : null,
  isPostApplication ? { label: "投稿だけ", Icon: Send, tone: "navy" } : null,
  hasPrize ? { label: "賞金あり", Icon: Gift, tone: "pink" } : null,
].filter(Boolean).slice(0, 2) as { label: string; Icon: typeof Sprout; tone: string }[];
---

<article
  class={`contest-card ${variant === "featured" ? "contest-card-featured" : ""}`}
  data-contest-card
  data-contest-slug={contest.slug}
  data-contest-categories={contest.categories.join(" ")}
  data-contest-deadline={contest.deadline}
  data-contest-status={contest.status}
  data-contest-beginner={isBeginner ? "true" : "false"}
  data-contest-prize={hasPrize ? "true" : "false"}
>
  <a class={`contest-thumb placeholder-${placeholderType} ${isFallbackThumbnail ? "is-fallback" : ""}`} href={`/contests/${contest.slug}`} aria-label={`${contest.title}の詳細を見る`}>
    <img
      src={thumbnail}
      data-fallback-src={fallbackThumbnail}
      alt=""
      loading={thumbnailLoading}
      decoding="async"
      onerror="this.onerror=null;this.src=this.dataset.fallbackSrc || '/images/contests/yuru-thumb-ai-image.webp';"
    />
    <span class="contest-badge-stack">
      <span class="category-label">{primaryCategory}</span>
      {contest.status === "upcoming" && <span class="contest-status-label">開催予定</span>}
    </span>
  </a>
  <button class="favorite-button" type="button" data-favorite-slug={contest.slug} data-favorite-label={contest.title} aria-label={`${contest.title}をお気に入りに追加`} aria-pressed="false">
    <Heart size={18} stroke-width={2.2} aria-hidden="true" />
  </button>
  <div class="contest-body">
    <h3 class="contest-title">
      <a href={`/contests/${contest.slug}`}>{contest.title}</a>
    </h3>
    <dl class="contest-summary">
      <div>
        <dt>締切</dt>
        <dd>{formatDate(contest.deadline)} まで</dd>
      </div>
      <div>
        <dt>賞品</dt>
        <dd>{prizeShort}</dd>
      </div>
    </dl>
    <div class="soft-tag-row" aria-label="参加しやすさ">
      {effortTags.map(({ label, Icon, tone }) => (
        <span class={`soft-tag soft-tag-${tone}`}><Icon size={14} stroke-width={2.1} aria-hidden="true" />{label}</span>
      ))}
    </div>
    <div class="card-actions">
      <a class="button primary" href={`/contests/${contest.slug}`}>詳細を見る</a>
    </div>
  </div>
</article>
