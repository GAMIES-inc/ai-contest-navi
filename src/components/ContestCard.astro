---
import { categoryLabels, formatDate } from "@/lib/contests";
import type { Contest } from "@/data/contests";

type Props = {
  contest: Contest;
  variant?: "default" | "featured";
};

const { contest, variant = "default" } = Astro.props;
const statusLabel =
  contest.status === "closing-soon"
    ? "締切間近"
    : contest.status === "open"
      ? "募集中"
      : contest.status === "ended"
        ? "終了"
        : "掲載中";
const thumbnail = contest.thumbnail || "/brand-thumbnail.svg";
---

<article class={`contest-card ${variant === "featured" ? "contest-card-featured" : ""}`}>
  <a class="contest-thumb" href={`/contests/${contest.slug}`} aria-label={`${contest.title}の詳細を見る`}>
    <img src={thumbnail} alt="" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/brand-thumbnail.svg';" />
    <span class={`status-badge ${contest.status}`}>{statusLabel}</span>
  </a>
  <div class="contest-body">
    <div class="card-topline">
      <span class="deadline-chip">締切 {formatDate(contest.deadline)}</span>
      <span class={`mini-status ${contest.status}`}>{statusLabel}</span>
    </div>
    <div class="tags compact">
      {contest.categories.slice(0, variant === "featured" ? 2 : 3).map((category) => <span class="tag">{categoryLabels[category]}</span>)}
    </div>
    <h3 class="contest-title">
      <a href={`/contests/${contest.slug}`}>{contest.title}</a>
    </h3>
    <p class="contest-description">{contest.description}</p>
    <div class="card-facts" aria-label="コンテストの主要情報">
      <div class="card-fact">
        <span>賞金/賞品</span>
        <strong>{contest.prize}</strong>
      </div>
      <div class="card-fact">
        <span>応募形式</span>
        <strong>{contest.applicationMethod}</strong>
      </div>
      <div class="card-fact">
        <span>参加目安</span>
        <strong>{contest.difficulty}</strong>
      </div>
    </div>
    <div class="card-actions">
      <a class="button primary" href={`/contests/${contest.slug}`}>詳細を見る</a>
      <a class="button" href={contest.officialUrl} target="_blank" rel="noreferrer">公式サイト</a>
    </div>
  </div>
</article>
