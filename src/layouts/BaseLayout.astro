---
type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
};

import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import { xContactUrl, xProfileUrl } from "@/lib/site";

const siteName = "ゆるコンテストなび";
const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = "/images/brand/yuru-og-home.webp",
} = Astro.props;

const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const resolvedOgImage = new URL(ogImage, Astro.site).toString();
const enableFirstPartyAnalytics = import.meta.env.PUBLIC_ENABLE_FIRST_PARTY_ANALYTICS === "true";
const cloudflareWebAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" href="/images/brand/yuru-rosette-watercolor.png" type="image/png" />
    {
      cloudflareWebAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareWebAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell nav">
        <a class="brand brand-lockup" href="/" aria-label={`${siteName} トップ`}>
          <img
            class="brand-logo-img"
            src="/images/brand/yuru-logo-lockup.png"
            alt={siteName}
            width="1823"
            height="433"
            loading="eager"
            decoding="async"
          />
        </a>
        <nav class="nav-links" aria-label="メインナビゲーション">
          <a href="/contests">コンテストを探す</a>
          <a href="/categories">カテゴリーから探す</a>
          <a href="/guides/start-ai-contest">初めての方へ</a>
          <a href="/submit">掲載希望の方へ</a>
          <a href={xProfileUrl} target="_blank" rel="noreferrer">お知らせ</a>
        </nav>
        <div class="nav-actions">
          <a class="nav-favorite" href="/contests#favorites" aria-label="お気に入りを見る">お気に入り</a>
          <a class="nav-cta" href="/submit">コンテストを掲載する</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="メニューを開く">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="mobile-menu-panel">
            <a href="/contests">コンテストを探す</a>
            <a href="/categories">カテゴリーから探す</a>
            <a href="/calendar">締切カレンダー</a>
            <a href="/guides/start-ai-contest">初めての方へ</a>
            <a href="/archive">アーカイブ</a>
            <a href={xProfileUrl} target="_blank" rel="noreferrer">お知らせ</a>
            <a href={xContactUrl} target="_blank" rel="noreferrer">Xで連絡する</a>
            <a class="nav-favorite" href="/contests#favorites">お気に入り</a>
            <a class="nav-cta" href="/submit">コンテストを掲載する</a>
          </div>
        </details>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      {`
        (() => {
          const noTrackStorageKey = "yuruContestNaviNoTrack";
          const legacyNoTrackStorageKey = ["ai", "Contest", "Navi", "NoTrack"].join("");
          const currentParams = new URLSearchParams(window.location.search);
          try {
            if (currentParams.get("no_track") === "1") localStorage.setItem(noTrackStorageKey, "1");
            if (currentParams.get("track") === "1" || currentParams.get("no_track") === "0") {
              localStorage.removeItem(noTrackStorageKey);
              localStorage.removeItem(legacyNoTrackStorageKey);
            } else if (localStorage.getItem(legacyNoTrackStorageKey) === "1") {
              localStorage.setItem(noTrackStorageKey, "1");
              localStorage.removeItem(legacyNoTrackStorageKey);
            }
          } catch {}

          let storedNoTrack = false;
          try {
            storedNoTrack = localStorage.getItem(noTrackStorageKey) === "1";
          } catch {}

          const relayParams = new URLSearchParams();
          relayParams.set("source_path", window.location.pathname || "/");
          ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((key) => {
            const value = currentParams.get(key);
            if (value) relayParams.set(key, value);
          });
          if (currentParams.get("no_track") === "1" || storedNoTrack) relayParams.set("no_track", "1");

          document.querySelectorAll('a[href^="/go/"]').forEach((link) => {
            try {
              const url = new URL(link.getAttribute("href") || "", window.location.origin);
              relayParams.forEach((value, key) => {
                if (!url.searchParams.has(key)) url.searchParams.set(key, value);
              });
              link.setAttribute("href", url.pathname + url.search + url.hash);
            } catch {}
          });
        })();
      `}
    </script>
    {
      enableFirstPartyAnalytics && (
        <script is:inline>
          {`
            (() => {
              if (window.__yuruContestNaviPageviewSent) return;
              window.__yuruContestNaviPageviewSent = true;
              const params = new URLSearchParams(window.location.search);
              let storedNoTrack = false;
              try {
                storedNoTrack = localStorage.getItem("yuruContestNaviNoTrack") === "1";
              } catch {}
              if (params.get("no_track") === "1" || storedNoTrack) return;
              const payload = {
                path: window.location.pathname,
                title: document.title,
                utm_source: params.get("utm_source") || "",
                utm_medium: params.get("utm_medium") || "",
                utm_campaign: params.get("utm_campaign") || "",
                utm_content: params.get("utm_content") || "",
                utm_term: params.get("utm_term") || ""
              };
              const body = JSON.stringify(payload);
              const url = "/api/analytics/pageview";
              try {
                if (navigator.sendBeacon) {
                  navigator.sendBeacon(url, new Blob([body], { type: "application/json" }));
                  return;
                }
                fetch(url, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body,
                  keepalive: true
                }).catch(() => {});
              } catch {}
            })();
          `}
        </script>
      )
    }
    <script is:inline>
      {`
        (() => {
          const key = "yuruContestFavorites";
          const readFavorites = () => {
            try {
              return new Set(JSON.parse(localStorage.getItem(key) || "[]"));
            } catch {
              return new Set();
            }
          };
          const writeFavorites = (items) => {
            try {
              localStorage.setItem(key, JSON.stringify([...items]));
            } catch {}
          };
          const updateButtons = () => {
            const favorites = readFavorites();
            document.querySelectorAll("[data-favorite-slug]").forEach((button) => {
              const slug = button.getAttribute("data-favorite-slug");
              const active = Boolean(slug && favorites.has(slug));
              button.classList.toggle("is-active", active);
              button.setAttribute("aria-pressed", active ? "true" : "false");
            });
          };
          document.addEventListener("click", (event) => {
            const button = event.target instanceof Element ? event.target.closest("[data-favorite-slug]") : null;
            if (!(button instanceof HTMLElement)) return;
            event.preventDefault();
            const slug = button.getAttribute("data-favorite-slug");
            if (!slug) return;
            const favorites = readFavorites();
            if (favorites.has(slug)) favorites.delete(slug);
            else favorites.add(slug);
            writeFavorites(favorites);
            updateButtons();
          });
          updateButtons();
        })();
      `}
    </script>
  </body>
</html>
