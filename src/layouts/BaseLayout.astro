---
type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
};

import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import { xContactUrl, xProfileUrl } from "@/lib/site";

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = "/og-default.svg",
} = Astro.props;

const pageTitle = title.includes("AIコンテストナビ") ? title : `${title} | AIコンテストナビ`;
const resolvedOgImage = new URL(ogImage, Astro.site).toString();
const enableFirstPartyAnalytics = import.meta.env.PUBLIC_ENABLE_FIRST_PARTY_ANALYTICS === "true";
const cloudflareWebAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AIコンテストナビ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" href="/brand-x-icon.png" type="image/png" />
    {
      cloudflareWebAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareWebAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell nav">
        <a class="brand" href="/" aria-label="AIコンテストナビ トップ">
          <span class="brand-mark"><img src="/brand-x-icon.png" alt="" /></span>
          <span>AIコンテストナビ</span>
        </a>
        <nav class="nav-links" aria-label="メインナビゲーション">
          <a href="/contests">コンテスト一覧</a>
          <a href="/#categories">ジャンルで探す</a>
          <a href="/calendar">締切カレンダー</a>
          <a href="/guides">ガイド</a>
          <a href="/archive">アーカイブ</a>
          <a href={xProfileUrl} target="_blank" rel="noreferrer">X</a>
          <a class="nav-cta" href="/submit">掲載について</a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="メニューを開く">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="mobile-menu-panel">
            <a href="/contests">コンテスト一覧</a>
            <a href="/#categories">ジャンルで探す</a>
            <a href="/calendar">締切カレンダー</a>
            <a href="/guides">ガイド</a>
            <a href="/archive">アーカイブ</a>
            <a href="/policy">掲載方針</a>
            <a href={xProfileUrl} target="_blank" rel="noreferrer">Xで更新を見る</a>
            <a href={xContactUrl} target="_blank" rel="noreferrer">Xで連絡する</a>
            <a class="nav-cta" href="/submit">掲載について</a>
          </div>
        </details>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      {`
        (() => {
          const currentParams = new URLSearchParams(window.location.search);
          const relayParams = new URLSearchParams();
          ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((key) => {
            const value = currentParams.get(key);
            if (value) relayParams.set(key, value);
          });
          if (currentParams.get("no_track") === "1") relayParams.set("no_track", "1");
          if (!relayParams.toString()) return;

          document.querySelectorAll('a[href^="/go/"]').forEach((link) => {
            try {
              const url = new URL(link.getAttribute("href") || "", window.location.origin);
              relayParams.forEach((value, key) => {
                if (!url.searchParams.has(key)) url.searchParams.set(key, value);
              });
              link.setAttribute("href", url.pathname + url.search + url.hash);
            } catch {}
          });
        })();
      `}
    </script>
    {
      enableFirstPartyAnalytics && (
        <script is:inline>
          {`
            (() => {
              if (window.__aiContestNaviPageviewSent) return;
              window.__aiContestNaviPageviewSent = true;
              const params = new URLSearchParams(window.location.search);
              if (params.get("no_track") === "1") return;
              const payload = {
                path: window.location.pathname,
                title: document.title,
                utm_source: params.get("utm_source") || "",
                utm_medium: params.get("utm_medium") || "",
                utm_campaign: params.get("utm_campaign") || "",
                utm_content: params.get("utm_content") || "",
                utm_term: params.get("utm_term") || ""
              };
              const body = JSON.stringify(payload);
              const url = "/api/analytics/pageview";
              try {
                if (navigator.sendBeacon) {
                  navigator.sendBeacon(url, new Blob([body], { type: "application/json" }));
                  return;
                }
                fetch(url, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body,
                  keepalive: true
                }).catch(() => {});
              } catch {}
            })();
          `}
        </script>
      )
    }
  </body>
</html>
